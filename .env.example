# ============================================================
# Global TrustFund - Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env or expose service-role keys to the frontend.

# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Supabase (Public - safe for frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Supabase (Server-side only - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Session / Auth
SESSION_SECRET=generate-a-long-random-string-here
JWT_EXPIRES_IN=7d

# Optional: Rate limiting & security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Feature flags (demo mode)
DEMO_MODE=true
ALLOW_DEMO_DATA=true
