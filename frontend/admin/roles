async function loadRoles() {

    try {

        const data =
            await fetchJson(
                `${API_BASE}/roles`
            );


        const records =
            Array.isArray(data)

                ? data

                : Array.isArray(
                    data.roles
                )

                    ? data.roles

                    : Array.isArray(
                        data.data
                    )

                        ? data.data

                        : [];


        roles =
            records.length
                ? records
                : demoRoles;


    } catch (error) {

        console.warn(
            "Roles API unavailable. Using demo data.",
            error
        );

        roles =
            demoRoles.map(
                role => ({
                    ...role,
                    permissions: [
                        ...(role.permissions || [])
                    ]
                })
            );

    }


    applyFilters();

}


