     *             ]
     *         })
     *     }
     * );
     *
     * roles.unshift(response.role || response);
     */


    roles.unshift(newRole);


    applyFilters();

    showToast(
        `Role "${name}" created successfully.`,
        "success"
    );

}


/* =========================================================
   ROLE ACTIONS
   ========================================================= */

function handleRoleAction(
    action,
    id
) {

    const role =
        roles.find(
            item =>
                item.id === id
        );


    if (!role) {
        return;
    }


    if (action === "view") {

        const permissions =
            (role.permissions || [])
                .map(
                    formatPermission
                )
                .join("\n");


        window.alert(
            `${role.name}\n\n` +
            `${role.description}\n\n` +
            `Type: ${role.type}\n\n` +
            `Permissions:\n${permissions || "None"}`
        );

        return;
    }


    if (action === "edit") {

        window.alert(
            `Role editing for "${role.name}" will connect to PATCH /api/roles/${role.id}.`
        );

        return;
    }


    if (action === "delete") {

        if (
            role.type === "system"
        ) {

            showToast(
                "System roles are protected.",
                "error"
            );

            return;
        }


        const confirmed =
            window.confirm(
                `Delete the custom role "${role.name}"?`
            );


        if (!confirmed) {
            return;
        }


        roles =
            roles.filter(
                item =>
                    item.id !== id
            );


        applyFilters();


        showToast(
            `Role "${role.name}" deleted.`,
            "success"
        );

    }

}


/* =========================================================
   PERMISSION CHANGES
   ========================================================= */

function handlePermissionChange(
    checkbox
) {

    const roleId =
        checkbox.dataset.roleId;

    const permission =
        checkbox.dataset.permission;


    const role =
        roles.find(
            item =>
                item.id === roleId
        );


    if (!role) {
        return;
    }


    if (
        !Array.isArray(
            role.permissions
        )
    ) {

        role.permissions = [];

    }


    if (checkbox.checked) {

        if (
            !role.permissions.includes(
                permission
            )
        ) {

            role.permissions.push(
                permission
            );

        }

    } else {

        role.permissions =
            role.permissions.filter(
                item =>
                    item !== permission
            );

    }


    updateSummary();


    /*
     * Production implementation:
     *
     * PATCH /api/roles/:id
     *
     * {
     *     permissions: role.permissions
     * }
     */


    showToast(
        "Permission updated.",
        "success"
    );

}


