<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="description"
        content="Global TrustFund administrator roles and permissions management."
    >

    <meta
        name="theme-color"
        content="#0b2a4a"
    >

    <title>Roles & Permissions | GTF Banking Admin</title>

    <link
        rel="stylesheet"
        href="../css/styles.css"
    >

    <style>
        /* =========================================================
           GLOBAL TRUSTFUND ADMIN
           ROLES & PERMISSIONS
           ========================================================= */

        :root {
            --gtf-blue: #0b2a4a;
            --gtf-blue-light: #145da0;
            --gtf-gold: #c9962b;

            --gtf-bg: #f4f7fa;
            --gtf-card: #ffffff;
            --gtf-border: #dce4eb;

            --gtf-text: #183247;
            --gtf-muted: #71808d;

            --gtf-success: #19734b;
            --gtf-success-bg: #eaf6ef;

            --gtf-warning: #946b17;
            --gtf-warning-bg: #fff7df;

            --gtf-danger: #a04444;
            --gtf-danger-bg: #fbeded;

            --gtf-shadow:
                0 8px 25px rgba(11, 42, 74, .06);

            --gtf-radius: 11px;
        }

        * {
            box-sizing: border-box;
        }

        html {
            min-height: 100%;
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: var(--gtf-bg);
            color: var(--gtf-text);
            font-family:
                Arial,
                Helvetica,
                sans-serif;
        }

        button,
        input,
        select,
        textarea {
            font: inherit;
        }

        button {
            cursor: pointer;
        }

        button:disabled {
            cursor: not-allowed;
            opacity: .55;
        }

        a {
            color: inherit;
        }

        :focus-visible {
            outline: 3px solid rgba(20, 93, 160, .3);
            outline-offset: 2px;
        }


        /* =========================================================
           SKIP LINK
           ========================================================= */

        .skip-link {
            position: fixed;
            top: -100px;
            left: 15px;
            z-index: 1000;
            padding: 9px 13px;
            border-radius: 6px;
            background: #fff;
            color: var(--gtf-blue);
            font-size: 9px;
            font-weight: 800;
            text-decoration: none;
            box-shadow: var(--gtf-shadow);
        }

        .skip-link:focus {
            top: 15px;
        }


        /* =========================================================
           APPLICATION
           ========================================================= */

        .admin-app {
            min-height: 100vh;

            display: grid;

            grid-template-columns:
                245px
                minmax(0, 1fr);
        }


        /* =========================================================
           SIDEBAR
           ========================================================= */

        .sidebar {
            position: sticky;
            top: 0;

            height: 100vh;

            overflow-y: auto;

            padding: 22px 16px;

            background: var(--gtf-blue);
            color: #fff;
        }

        .brand {
            display: flex;
            align-items: center;

            gap: 10px;

            padding:
                5px
                8px
                24px;

            border-bottom:
                1px solid
                rgba(255,255,255,.12);

            color: #fff;
            text-decoration: none;
        }

        .brand img {
            width: 43px;
            height: 43px;

            flex: 0 0 auto;

            object-fit: contain;
        }

        .brand-text {
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .brand-text strong {
            font-size: 13px;
            line-height: 1.2;
        }

        .brand-text span {
            margin-top: 3px;

            color:
                rgba(255,255,255,.58);

            font-size: 8px;
            line-height: 1.2;
        }

        .nav-title {
            margin:
                24px
                9px
                9px;

            color:
                rgba(255,255,255,.42);

            font-size: 7px;
            font-weight: 800;

            letter-spacing: 1px;

            text-transform: uppercase;
        }

        .nav {
            display: grid;
            gap: 5px;
        }

        .nav a {
            display: flex;
            align-items: center;

            gap: 10px;

            min-height: 38px;

            padding: 0 11px;

            border-radius: 7px;

            color:
                rgba(255,255,255,.72);

            font-size: 9px;
            font-weight: 600;

            text-decoration: none;

            transition:
                background .15s ease,
                color .15s ease;
        }

        .nav a:hover,
        .nav a.active {
            background:
                rgba(255,255,255,.10);

            color: #fff;
        }

        .nav-icon {
            width: 18px;

            flex: 0 0 18px;

            text-align: center;

            font-size: 11px;
        }

        .admin-user {
            margin-top: 30px;

            padding: 13px;

            border:
                1px solid
                rgba(255,255,255,.10);

            border-radius: 9px;

            background:
                rgba(255,255,255,.05);
        }

        .admin-user strong {
            display: block;

            color: #fff;

            font-size: 9px;
        }

        .admin-user span {
            display: block;

            margin-top: 4px;

            color:
                rgba(255,255,255,.55);

            font-size: 7px;
        }

        .logout {
            width: 100%;

            min-height: 30px;

            margin-top: 10px;

            border:
                1px solid
                rgba(255,255,255,.15);

            border-radius: 6px;

            background: transparent;

            color:
                rgba(255,255,255,.75);

            font-size: 8px;
        }

        .logout:hover {
            background:
                rgba(255,255,255,.08);
        }


        /* =========================================================
           MAIN
           ========================================================= */

        .main {
            min-width: 0;
        }

        .topbar {
            min-height: 68px;

            padding:
                14px
                28px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 20px;

            background: #fff;

            border-bottom:
                1px solid
                var(--gtf-border);
        }

        .topbar h1 {
            margin: 0;

            color: var(--gtf-blue);

            font-size: 20px;
            line-height: 1.2;
        }

        .topbar p {
            margin:
                5px
                0
                0;

            color: var(--gtf-muted);

            font-size: 8px;
            line-height: 1.4;
        }

        .session-status {
            padding:
                7px
                10px;

            border-radius: 20px;

            background:
                var(--gtf-success-bg);

            color:
                var(--gtf-success);

            font-size: 7px;
            font-weight: 700;

            white-space: nowrap;
        }

        .content {
            padding: 27px;
        }


        /* =========================================================
           SUMMARY
           ========================================================= */

        .summary-grid {
            display: grid;

            grid-template-columns:
                repeat(4, minmax(0, 1fr));

            gap: 15px;

            margin-bottom: 20px;
        }

        .summary-card {
            padding: 17px;

            background: var(--gtf-card);

            border:
                1px solid
                var(--gtf-border);

            border-radius: 10px;

            box-shadow: var(--gtf-shadow);
        }

        .summary-label {
            color: var(--gtf-muted);

            font-size: 7px;
            font-weight: 800;

            letter-spacing: .5px;

            text-transform: uppercase;
        }

        .summary-value {
            margin-top: 7px;

            color: var(--gtf-blue);

            font-size: 21px;
            font-weight: 800;

            line-height: 1;
        }

        .summary-note {
            margin-top: 7px;

            color: var(--gtf-muted);

            font-size: 7px;
            line-height: 1.4;
        }


        /* =========================================================
           TOOLBAR
           ========================================================= */

        .toolbar-card {
            margin-bottom: 20px;

            padding: 17px;

            background: #fff;

            border:
                1px solid
                var(--gtf-border);

            border-radius: var(--gtf-radius);

            box-shadow: var(--gtf-shadow);
        }

        .toolbar {
            display: grid;

            grid-template-columns:
                minmax(180px, 1fr)
                180px
                auto
                auto;

            gap: 10px;
        }

        .search,
        .filter {
            width: 100%;

            min-height: 36px;

            padding:
                0
                10px;

            border:
                1px solid
                var(--gtf-border);

            border-radius: 6px;

            outline: none;

            background: #fff;

            color: var(--gtf-text);

            font-size: 8px;
        }

        .search::placeholder {
            color: #9aa7b2;
        }

        .search:focus,
        .filter:focus {
            border-color:
                var(--gtf-blue-light);
        }


        /* =========================================================
           BUTTONS
           ========================================================= */

        .button {
            min-height: 36px;

            padding:
                0
                14px;

            border: 0;

            border-radius: 6px;

            background:
                var(--gtf-blue);

            color: #fff;

            font-size: 8px;
            font-weight: 700;

            transition:
                background .15s ease,
                transform .1s ease;
        }

        .button:hover {
            background:
                var(--gtf-blue-light);
        }

        .button:active {
            transform: translateY(1px);
        }

        .button.secondary {
            background: #eef3f7;
            color: var(--gtf-blue);
        }

        .button.secondary:hover {
            background: #e2eaf0;
        }


        /* =========================================================
           ROLE GRID
           ========================================================= */

        .role-grid {
            display: grid;

            grid-template-columns:
                repeat(3, minmax(0, 1fr));

            gap: 16px;
        }

        .role-card {
            display: flex;
            flex-direction: column;

            min-width: 0;

            background: #fff;

            border:
                1px solid
                var(--gtf-border);

            border-radius: var(--gtf-radius);

            overflow: hidden;

            box-shadow: var(--gtf-shadow);
        }

        .role-header {
            padding: 16px;

            border-bottom:
                1px solid
                var(--gtf-border);
        }

        .role-header-row {
            display: flex;

            align-items: flex-start;

            justify-content: space-between;

            gap: 10px;
        }

        .role-name {
            margin: 0;

            color: var(--gtf-blue);

            font-size: 13px;
            line-height: 1.3;
        }

        .role-description {
            margin:
                6px
                0
                0;

            color: var(--gtf-muted);

            font-size: 7px;

            line-height: 1.5;
        }

        .role-badge {
            display: inline-block;

            padding:
                4px
                7px;

            border-radius: 20px;

            background: #eef3f7;

            color: var(--gtf-blue);

            font-size: 6px;
            font-weight: 800;

            text-transform: uppercase;

            white-space: nowrap;
        }

        .role-badge.system {
            background:
                var(--gtf-success-bg);

            color:
                var(--gtf-success);
        }

        .role-body {
            flex: 1;

            padding:
                15px
                16px;
        }

        .permission-title {
            margin-bottom: 9px;

            color: var(--gtf-muted);

            font-size: 7px;
            font-weight: 800;

            letter-spacing: .4px;

            text-transform: uppercase;
        }

        .permissions {
            display: grid;
            gap: 7px;
        }

        .permission {
            display: flex;
            align-items: center;

            gap: 7px;

            min-height: 22px;

            color: var(--gtf-text);

            font-size: 7px;

            cursor: pointer;
        }

        .permission input {
            width: 13px;
            height: 13px;

            margin: 0;

            accent-color:
                var(--gtf-blue);
        }

        .role-footer {
            padding:
                12px
                16px;

            border-top:
                1px solid
                var(--gtf-border);

            display: flex;

            justify-content: flex-end;

            flex-wrap: wrap;

            gap: 7px;
        }

        .small-button {
            min-height: 29px;

            padding:
                0
                9px;

            border:
                1px solid
                var(--gtf-border);

            border-radius: 5px;

            background: #fff;

            color: var(--gtf-blue);

            font-size: 7px;
            font-weight: 700;
        }

        .small-button:hover {
            background: #f5f8fa;
        }

        .small-button.primary {
            border-color:
                var(--gtf-blue);

            background:
                var(--gtf-blue);

            color: #fff;
        }

        .small-button.primary:hover {
            background:
                var(--gtf-blue-light);

            border-color:
                var(--gtf-blue-light);
        }

        .small-button.danger {
            border-color: #ecd2d2;

            background:
                var(--gtf-danger-bg);

            color:
                var(--gtf-danger);
        }

        .small-button.danger:hover {
            background: #f7e4e4;
        }


        /* =========================================================
           EMPTY STATE
           ========================================================= */

        .empty-state {
            grid-column: 1 / -1;

            padding: 40px 20px;

            text-align: center;

            background: #fff;

            border:
                1px solid
                var(--gtf-border);

            border-radius: var(--gtf-radius);

            color: var(--gtf-muted);

            font-size: 8px;
        }

        .empty-state strong {
            display: block;

            margin-bottom: 5px;

            color: var(--gtf-blue);

            font-size: 11px;
        }


        /* =========================================================
           ASSIGNMENTS
           ========================================================= */

        .assignments {
            margin-top: 20px;

            background: #fff;

            border:
                1px solid
                var(--gtf-border);

            border-radius: var(--gtf-radius);

            overflow: hidden;

            box-shadow: var(--gtf-shadow);
        }

        .section-header {
            padding:
                17px
                18px;

            border-bottom:
                1px solid
                var(--gtf-border);
        }

        .section-header h2 {
            margin: 0;

            color: var(--gtf-blue);

            font-size: 13px;
        }

        .section-header p {
            margin:
                5px
                0
                0;

            color: var(--gtf-muted);

            font-size: 7px;
        }

        .table-wrap {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            min-width: 760px;

            border-collapse: collapse;
        }

        th {
            padding:
                11px
                14px;

            background: #f8fafb;

            border-bottom:
                1px solid
                var(--gtf-border);

            color: var(--gtf-muted);

            font-size: 7px;
            font-weight: 800;

            text-align: left;

            text-transform: uppercase;
        }

        td {
            padding:
                12px
                14px;

            border-bottom:
                1px solid
                #edf1f4;

            font-size: 8px;
        }

        tbody tr:last-child td {
            border-bottom: 0;
        }

        tbody tr:hover {
            background: #fafcfd;
        }

        .employee {
            display: flex;
            align-items: center;

            gap: 9px;
        }

        .avatar {
            width: 30px;
            height: 30px;

            flex: 0 0 30px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;

            background: #e8eef4;

            color: var(--gtf-blue);

            font-size: 8px;
            font-weight: 800;
        }

        .employee-info {
            min-width: 0;
        }

        .employee-info strong {
            display: block;

            color: var(--gtf-blue);

            font-size: 8px;
        }

        .employee-info span {
            display: block;

            margin-top: 3px;

            color: var(--gtf-muted);

            font-size: 7px;
        }

        .assigned-role {
            display: inline-block;

            padding:
                4px
                7px;

            border-radius: 20px;

            background: #eef3f7;

            color: var(--gtf-blue);

            font-size: 6px;
            font-weight: 800;

            white-space: nowrap;
        }

        .assigned-role.super {
            background:
                var(--gtf-success-bg);

            color:
                var(--gtf-success);
        }

        .table-action {
            border: 0;

            background: transparent;

            color:
                var(--gtf-blue-light);

            font-size: 7px;
            font-weight: 700;
        }

        .table-action:hover {
            text-decoration: underline;
        }


        /* =========================================================
           NATIVE DIALOG
           ========================================================= */

        dialog {
            width: min(600px, calc(100% - 30px));

            max-height: 90vh;

            padding: 0;

            border: 0;

            border-radius: 12px;

            background: #fff;

            color: var(--gtf-text);

            box-shadow:
                0 25px 70px
                rgba(0,0,0,.22);
        }

        dialog::backdrop {
            background:
                rgba(5, 20, 32, .55);
        }

        .modal-card {
            padding: 23px;
        }

        .modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 15px;

            margin-bottom: 18px;
        }

        .modal-header h2 {
            margin: 0;

            color: var(--gtf-blue);

            font-size: 16px;
        }

        .close {
            width: 30px;
            height: 30px;

            border: 0;

            border-radius: 50%;

            background: #eef2f5;

            color: var(--gtf-blue);

            font-size: 16px;
            line-height: 1;
        }

        .close:hover {
            background: #e4ebf0;
        }

        .form-grid {
            display: grid;
            gap: 13px;
        }

        .form-field {
            display: grid;
            gap: 5px;
        }

        .form-field label {
            color: var(--gtf-text);

            font-size: 7px;
            font-weight: 700;
        }

        .form-field input,
        .form-field textarea {
            width: 100%;

            padding: 9px;

            border:
                1px solid
                var(--gtf-border);

            border-radius: 6px;

            outline: none;

            background: #fff;

            color: var(--gtf-text);

            font-size: 8px;
        }

        .form-field textarea {
            min-height: 85px;

            resize: vertical;
        }

        .form-field input:focus,
        .form-field textarea:focus {
            border-color:
                var(--gtf-blue-light);
        }

        .modal-actions {
            display: flex;

            justify-content: flex-end;

            gap: 8px;

            margin-top: 18px;
        }


        /* =========================================================
           TOAST
           ========================================================= */

        .toast {
            position: fixed;

            right: 20px;
            bottom: 20px;

            z-index: 200;

            max-width: 320px;

            padding:
                11px
                14px;

            border-radius: 8px;

            background:
                var(--gtf-blue);

            color: #fff;

            font-size: 8px;
            font-weight: 700;

            box-shadow:
                0 12px 30px
                rgba(0,0,0,.18);

            opacity: 0;

            transform:
                translateY(10px);

            pointer-events: none;

            transition:
                opacity .2s ease,
                transform .2s ease;
        }

        .toast.show {
            opacity: 1;

            transform:
                translateY(0);
        }

        .toast.success {
            background:
                var(--gtf-success);
        }

        .toast.error {
            background:
                var(--gtf-danger);
        }


        /* =========================================================
           RESPONSIVE
           ========================================================= */

        @media (max-width: 1100px) {

            .role-grid {
                grid-template-columns:
                    repeat(2, minmax(0, 1fr));
            }

            .summary-grid {
                grid-template-columns:
                    repeat(2, minmax(0, 1fr));
            }

            .toolbar {
                grid-template-columns:
                    1fr
                    1fr;
            }
        }


        @media (max-width: 800px) {

            .admin-app {
                grid-template-columns: 1fr;
            }

            .sidebar {
                position: static;

                width: 100%;

                height: auto;
            }

            .nav {
                grid-template-columns:
                    repeat(2, minmax(0, 1fr));
            }

            .admin-user {
                display: none;
            }

            .content {
                padding: 17px;
            }

            .topbar {
                padding:
                    13px
                    17px;
            }
        }


        @media (max-width: 580px) {

            .summary-grid,
            .role-grid,
            .toolbar {
                grid-template-columns: 1fr;
            }

            .topbar h1 {
                font-size: 17px;
            }

            .session-status {
                display: none;
            }

            .nav {
                grid-template-columns: 1fr;
            }

            .content {
                padding: 13px;
            }

            .modal-card {
                padding: 18px;
            }
        }


        @media (prefers-reduced-motion: reduce) {

            html {
                scroll-behavior: auto;
            }

            *,
            *::before,
            *::after {
                transition-duration: .01ms !important;
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
            }
        }
    </style>
</head>

