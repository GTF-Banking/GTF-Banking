   ASSIGNMENT ACTION
   ========================================================= */

function handleAssignmentAction(
    id
) {

    const assignment =
        assignments.find(
            item =>
                item.id === id
        );


    if (!assignment) {
        return;
    }


    window.alert(
        `Role assignment management for ${assignment.name} will connect to the backend assignment endpoint.`
    );

}


/* =========================================================
   EVENT LISTENERS
   ========================================================= */

roleSearch.addEventListener(
    "input",
    applyFilters
);


roleFilter.addEventListener(
    "change",
    applyFilters
);


document
    .getElementById(
        "resetButton"
    )
    .addEventListener(
        "click",
        () => {

            roleSearch.value = "";

            roleFilter.value = "";

            applyFilters();

        }
    );


document
    .getElementById(
        "newRoleButton"
    )
    .addEventListener(
        "click",
        openRoleDialog
    );


document
    .getElementById(
        "closeDialogButton"
    )
    .addEventListener(
        "click",
        closeRoleDialog
    );


document
    .getElementById(
        "cancelButton"
    )
    .addEventListener(
        "click",
        closeRoleDialog
    );


roleDialog.addEventListener(
    "click",
    event => {

        const rect =
            roleDialog.getBoundingClientRect();


        const inside =
            event.clientX >= rect.left &&
            event.clientX <= rect.right &&
            event.clientY >= rect.top &&
            event.clientY <= rect.bottom;


        if (!inside) {
            closeRoleDialog();
        }

    }
);


roleForm.addEventListener(
    "submit",
    async event => {

        event.preventDefault();


        const name =
            document
                .getElementById(
                    "roleName"
                )
                .value
                .trim();


        const description =
            document
                .getElementById(
                    "roleDescription"
                )
                .value
                .trim();


        if (
            !name ||
            !description
        ) {

            showToast(
                "Please complete all required fields.",
                "error"
            );

            return;
        }


        try {

            await createRole(
                name,
                description
            );


            roleForm.reset();

            closeRoleDialog();

        } catch (error) {

            console.error(
                "Role creation failed:",
                error
            );

            showToast(
                "Unable to create the role.",
                "error"
            );

        }

    }
);


roleGrid.addEventListener(
    "click",
    event => {

        const button =
            event.target.closest(
                "[data-action]"
            );


        if (!button) {
            return;
        }


        handleRoleAction(
            button.dataset.action,
            button.dataset.id
        );

    }
);


roleGrid.addEventListener(
    "change",
    event => {

        if (
            event.target.matches(
                'input[type="checkbox"][data-role-id]'
            )
        ) {

            handlePermissionChange(
                event.target
            );

        }

    }
);


document
    .getElementById(
        "assignmentTable"
    )
    .addEventListener(
        "click",
        event => {

            const button =
                event.target.closest(
                    "[data-assignment-id]"
                );


            if (!button) {
                return;
            }


            handleAssignmentAction(
                button.dataset.assignmentId
            );

        }
    );


document
    .getElementById(
        "logoutButton"
    )
    .addEventListener(
        "click",
        () => {

            /*
             * Production authentication:
             *
             * await supabase.auth.signOut();
             *
             * Then redirect to admin login.
             */

            window.location.href =
                "./login.html";

        }
    );


/* =========================================================
   INITIALIZE
   ========================================================= */

renderAssignments();

loadRoles();

</script>

</body>
</html>
