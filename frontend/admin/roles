<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="description"
        content="Global TrustFund administrator roles and permissions management."
    >

    <meta name="theme-color" content="#0b2a4a">

    <title>Roles & Permissions | GTF Banking Admin</title>

    <link rel="stylesheet" href="../css/styles.css">

    <style>
        :root {
            --gtf-blue: #0b2a4a;
            --gtf-blue-light: #145da0;
            --gtf-gold: #c9962b;
            --gtf-bg: #f4f7fa;
            --gtf-card: #ffffff;
            --gtf-border: #dce4eb;
            --gtf-text: #183247;
            --gtf-muted: #71808d;
            --gtf-success: #19734b;
            --gtf-success-bg: #eaf6ef;
            --gtf-warning: #946b17;
            --gtf-warning-bg: #fff7df;
            --gtf-danger: #a04444;
            --gtf-danger-bg: #fbeded;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            min-height: 100%;
        }

        body {
            background: var(--gtf-bg);
            color: var(--gtf-text);
            font-family: Arial, Helvetica, sans-serif;
        }

        button,
        input,
        select {
            font: inherit;
        }

        button {
            cursor: pointer;
        }

        /* =========================
           APP LAYOUT
        ========================= */

        .admin-app {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 245px minmax(0, 1fr);
        }

        /* =========================
           SIDEBAR
        ========================= */

        .sidebar {
            position: sticky;
            top: 0;
            height: 100vh;
            overflow-y: auto;
            padding: 22px 16px;
            background: var(--gtf-blue);
            color: #fff;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 5px 8px 24px;
            border-bottom: 1px solid rgba(255,255,255,.12);
            color: #fff;
            text-decoration: none;
        }

        .brand img {
            width: 43px;
            height: 43px;
            object-fit: contain;
        }

        .brand-text {
            display: flex;
            flex-direction: column;
        }

        .brand-text strong {
            font-size: 13px;
        }

        .brand-text span {
            margin-top: 3px;
            color: rgba(255,255,255,.58);
            font-size: 8px;
        }

        .nav-title {
            margin: 24px 9px 9px;
            color: rgba(255,255,255,.42);
            font-size: 7px;
            font-weight: 800;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .nav {
            display: grid;
            gap: 5px;
        }

        .nav a {
            display: flex;
            align-items: center;
            gap: 10px;
            min-height: 38px;
            padding: 0 11px;
            border-radius: 7px;
            color: rgba(255,255,255,.72);
            font-size: 9px;
            font-weight: 600;
            text-decoration: none;
        }

        .nav a:hover,
        .nav a.active {
            background: rgba(255,255,255,.10);
            color: #fff;
        }

        .nav-icon {
            width: 18px;
            text-align: center;
            font-size: 11px;
        }

        .admin-user {
            margin-top: 30px;
            padding: 13px;
            border: 1px solid rgba(255,255,255,.10);
            border-radius: 9px;
            background: rgba(255,255,255,.05);
        }

        .admin-user strong {
            display: block;
            font-size: 9px;
        }

        .admin-user span {
            display: block;
            margin-top: 4px;
            color: rgba(255,255,255,.55);
            font-size: 7px;
        }

        .logout {
            width: 100%;
            min-height: 30px;
            margin-top: 10px;
            border: 1px solid rgba(255,255,255,.15);
            border-radius: 6px;
            background: transparent;
            color: rgba(255,255,255,.75);
            font-size: 8px;
        }

        .logout:hover {
            background: rgba(255,255,255,.08);
        }

        /* =========================
           MAIN
        ========================= */

        .main {
            min-width: 0;
        }

        .topbar {
            min-height: 68px;
            padding: 14px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            background: #fff;
            border-bottom: 1px solid var(--gtf-border);
        }

        .topbar h1 {
            margin: 0;
            color: var(--gtf-blue);
            font-size: 20px;
        }

        .topbar p {
            margin: 5px 0 0;
            color: var(--gtf-muted);
            font-size: 8px;
        }

        .session-status {
            padding: 7px 10px;
            border-radius: 20px;
            background: var(--gtf-success-bg);
            color: var(--gtf-success);
            font-size: 7px;
            font-weight: 700;
        }

        .content {
            padding: 27px;
        }

        /* =========================
           SUMMARY
        ========================= */

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            margin-bottom: 20px;
        }

        .summary-card {
            padding: 17px;
            background: #fff;
            border: 1px solid var(--gtf-border);
            border-radius: 10px;
        }

        .summary-label {
            color: var(--gtf-muted);
            font-size: 7px;
            font-weight: 800;
            letter-spacing: .5px;
            text-transform: uppercase;
        }

        .summary-value {
            margin-top: 7px;
            color: var(--gtf-blue);
            font-size: 21px;
            font-weight: 800;
        }

        .summary-note {
            margin-top: 5px;
            color: var(--gtf-muted);
            font-size: 7px;
        }

        /* =========================
           TOOLBAR
        ========================= */

        .toolbar-card {
            margin-bottom: 20px;
            padding: 17px;
            background: #fff;
            border: 1px solid var(--gtf-border);
            border-radius: 11px;
        }

        .toolbar {
            display: grid;
            grid-template-columns: 1fr 180px auto auto;
            gap: 10px;
        }

        .search,
        .filter {
            width: 100%;
            min-height: 36px;
            padding: 0 10px;
            border: 1px solid var(--gtf-border);
            border-radius: 6px;
            outline: none;
            background: #fff;
            color: var(--gtf-text);
            font-size: 8px;
        }

        .search:focus,
        .filter:focus {
            border-color: var(--gtf-blue-light);
        }

        .button {
            min-height: 36px;
            padding: 0 14px;
            border: 0;
            border-radius: 6px;
            background: var(--gtf-blue);
            color: #fff;
            font-size: 8px;
            font-weight: 700;
        }

        .button:hover {
            background: var(--gtf-blue-light);
        }

        .button.secondary {
            background: #eef3f7;
            color: var(--gtf-blue);
        }

        /* =========================
           ROLE GRID
        ========================= */

        .role-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 16px;
        }

        .role-card {
            background: #fff;
            border: 1px solid var(--gtf-border);
            border-radius: 11px;
            overflow: hidden;
        }

        .role-header {
            padding: 16px;
            border-bottom: 1px solid var(--gtf-border);
        }

        .role-header-row {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 10px;
        }

        .role-name {
            margin: 0;
            color: var(--gtf-blue);
            font-size: 13px;
        }

        .role-description {
            margin: 6px 0 0;
            color: var(--gtf-muted);
            font-size: 7px;
            line-height: 1.5;
        }

        .role-badge {
            display: inline-block;
            padding: 4px 7px;
            border-radius: 20px;
            background: #eef3f7;
            color: var(--gtf-blue);
            font-size: 6px;
            font-weight: 800;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .role-badge.system {
            background: var(--gtf-success-bg);
            color: var(--gtf-success);
        }

        .role-body {
            padding: 15px 16px;
        }

        .permission-title {
            margin-bottom: 9px;
            color: var(--gtf-muted);
            font-size: 7px;
            font-weight: 800;
            letter-spacing: .4px;
            text-transform: uppercase;
        }

        .permissions {
            display: grid;
            gap: 7px;
        }

        .permission {
            display: flex;
            align-items: center;
            gap: 7px;
            color: var(--gtf-text);
            font-size: 7px;
        }

        .permission input {
            width: 13px;
            height: 13px;
            margin: 0;
            accent-color: var(--gtf-blue);
        }

        .role-footer {
            padding: 12px 16px;
            border-top: 1px solid var(--gtf-border);
            display: flex;
            justify-content: flex-end;
            gap: 7px;
        }

        .small-button {
            min-height: 29px;
            padding: 0 9px;
            border: 1px solid var(--gtf-border);
            border-radius: 5px;
            background: #fff;
            color: var(--gtf-blue);
            font-size: 7px;
            font-weight: 700;
        }

        .small-button.primary {
            border-color: var(--gtf-blue);
            background: var(--gtf-blue);
            color: #fff;
        }

        .small-button.danger {
            border-color: #ecd2d2;
            background: var(--gtf-danger-bg);
            color: var(--gtf-danger);
        }

        /* =========================
           ASSIGNMENTS
        ========================= */

        .assignments {
            margin-top: 20px;
            background: #fff;
            border: 1px solid var(--gtf-border);
            border-radius: 11px;
            overflow: hidden;
        }

        .section-header {
            padding: 17px 18px;
            border-bottom: 1px solid var(--gtf-border);
        }

        .section-header h2 {
            margin: 0;
            color: var(--gtf-blue);
            font-size: 13px;
        }

        .section-header p {
            margin: 5px 0 0;
            color: var(--gtf-muted);
            font-size: 7px;
        }

        .table-wrap {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            min-width: 760px;
            border-collapse: collapse;
        }

        th {
            padding: 11px 14px;
            background: #f8fafb;
            border-bottom: 1px solid var(--gtf-border);
            color: var(--gtf-muted);
            font-size: 7px;
            font-weight: 800;
            text-align: left;
            text-transform: uppercase;
        }

        td {
            padding: 12px 14px;
            border-bottom: 1px solid #edf1f4;
            font-size: 8px;
        }

        tbody tr:hover {
            background: #fafcfd;
        }

        .employee {
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .avatar {
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #e8eef4;
            color: var(--gtf-blue);
            font-size: 8px;
            font-weight: 800;
        }

        .employee-info strong {
            display: block;
            color: var(--gtf-blue);
            font-size: 8px;
        }

        .employee-info span {
            display: block;
            margin-top: 3px;
            color: var(--gtf-muted);
            font-size: 7px;
        }

        .assigned-role {
            display: inline-block;
            padding: 4px 7px;
            border-radius: 20px;
            background: #eef3f7;
            color: var(--gtf-blue);
            font-size: 6px;
            font-weight: 800;
        }

        .assigned-role.super {
            background: var(--gtf-success-bg);
            color: var(--gtf-success);
        }

        .table-action {
            border: 0;
            background: transparent;
            color: var(--gtf-blue-light);
            font-size: 7px;
            font-weight: 700;
        }

        /* =========================
           MODAL
        ========================= */

        .modal {
            position: fixed;
            inset: 0;
            z-index: 100;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: rgba(5, 20, 32, .55);
        }

        .modal.open {
            display: flex;
        }

        .modal-card {
            width: min(600px, 100%);
            max-height: 90vh;
            overflow-y: auto;
            padding: 23px;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 25px 70px rgba(0,0,0,.2);
        }

        .modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            margin-bottom: 18px;
        }

        .modal-header h2 {
            margin: 0;
            color: var(--gtf-blue);
            font-size: 16px;
        }

        .close {
            width: 30px;
            height: 30px;
            border: 0;
            border-radius: 50%;
            background: #eef2f5;
            color: var(--gtf-blue);
            font-size: 16px;
        }

        .form-grid {
            display: grid;
            gap: 13px;
        }

        .form-field {
            display: grid;
            gap: 5px;
        }

        .form-field label {
            color: var(--gtf-text);
            font-size: 7px;
            font-weight: 700;
        }

        .form-field input,
        .form-field textarea {
            width: 100%;
            padding: 9px;
            border: 1px solid var(--gtf-border);
            border-radius: 6px;
            outline: none;
            color: var(--gtf-text);
            font-size: 8px;
            resize: vertical;
        }

        .form-field textarea {
            min-height: 70px;
        }

        .form-field input:focus,
        .form-field textarea:focus {
            border-color: var(--gtf-blue-light);
        }

        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            margin-top: 18px;
        }

        /* =========================
           RESPONSIVE
        ========================= */

        @media (max-width: 1100px) {
            .role-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .summary-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .toolbar {
                grid-template-columns: 1fr 1fr;
            }
        }

        @media (max-width: 800px) {
            .admin-app {
                grid-template-columns: 1fr;
            }

            .sidebar {
                position: static;
                height: auto;
            }

            .nav {
                grid-template-columns: repeat(2, 1fr);
            }

            .admin-user {
                display: none;
            }

            .content {
                padding: 17px;
            }
        }

        @media (max-width: 580px) {
            .summary-grid,
            .role-grid,
            .toolbar {
                grid-template-columns: 1fr;
            }

            .topbar {
                padding: 13px 17px;
            }

            .session-status {
                display: none;
            }
        }
    </style>
</head>

<body>

<div class="admin-app">

    <!-- =========================
         SIDEBAR
    ========================== -->

    <aside class="sidebar">

        <a href="./index.html" class="brand">

            <img
                src="../assets/gtf-logo.svg"
                alt="Global TrustFund logo"
            >

            <span class="brand-text">
                <strong>Global TrustFund</strong>
                <span>Administration Portal</span>
            </span>

        </a>


        <div class="nav-title">
            Management
        </div>


        <nav class="nav">

            <a href="./index.html">
                <span class="nav-icon">⌂</span>
                Dashboard
            </a>

            <a href="./customers.html">
                <span class="nav-icon">♙</span>
                Customers
            </a>

            <a href="./accounts.html">
                <span class="nav-icon">▣</span>
                Accounts
            </a>

            <a href="./transactions.html">
                <span class="nav-icon">⇄</span>
                Transactions
            </a>

            <a href="./compliance.html">
                <span class="nav-icon">✓</span>
                Compliance
            </a>

            <a href="./audit.html">
                <span class="nav-icon">◌</span>
                Audit Logs
            </a>

            <a href="./report.html">
                <span class="nav-icon">▤</span>
                Reports
            </a>

            <a href="./roles.html" class="active">
                <span class="nav-icon">♟</span>
                Roles
            </a>

            <a href="./settings.html">
                <span class="nav-icon">⚙</span>
                Settings
            </a>

        </nav>


        <div class="admin-user">

            <strong>
                Administrator
            </strong>

            <span>
                Access Control Management
            </span>

            <button
                type="button"
                class="logout"
                id="logoutButton"
            >
                Sign Out
            </button>

        </div>

    </aside>


    <!-- =========================
         MAIN
    ========================== -->

    <main class="main">

        <header class="topbar">

            <div>

                <h1>
                    Roles & Permissions
                </h1>

                <p>
                    Manage administrator roles and access permissions.
                </p>

            </div>

            <span class="session-status">
                ● Admin Session Active
            </span>

        </header>


        <section class="content">


            <!-- =========================
                 SUMMARY
            ========================== -->

            <section class="summary-grid">

                <div class="summary-card">

                    <div class="summary-label">
                        Total Roles
                    </div>

                    <div
                        class="summary-value"
                        id="totalRoles"
                    >
                        0
                    </div>

                    <div class="summary-note">
                        Configured administrator roles
                    </div>

                </div>


                <div class="summary-card">

                    <div class="summary-label">
                        Administrators
                    </div>

                    <div
                        class="summary-value"
                        id="totalAdmins"
                    >
                        0
                    </div>

                    <div class="summary-note">
                        Users assigned administrative roles
                    </div>

                </div>


                <div class="summary-card">

                    <div class="summary-label">
                        Permissions
                    </div>

                    <div
                        class="summary-value"
                        id="totalPermissions"
                    >
                        0
                    </div>

                    <div class="summary-note">
                        Available access permissions
                    </div>

                </div>


                <div class="summary-card">

                    <div class="summary-label">
                        System Roles
                    </div>

                    <div
                        class="summary-value"
                        id="systemRoles"
                    >
                        0
                    </div>

                    <div class="summary-note">
                        Protected system roles
                    </div>

                </div>

            </section>


            <!-- =========================
                 TOOLBAR
            ========================== -->

            <section class="toolbar-card">

                <div class="toolbar">

                    <input
                        type="search"
                        id="roleSearch"
                        class="search"
                        placeholder="Search roles..."
                        aria-label="Search roles"
                    >


                    <select
                        id="roleFilter"
                        class="filter"
                        aria-label="Filter roles"
                    >

                        <option value="">
                            All role types
                        </option>

                        <option value="system">
                            System roles
                        </option>

                        <option value="custom">
                            Custom roles
                        </option>

                    </select>


                    <button
                        type="button"
                        class="button secondary"
                        id="resetButton"
                    >
                        Reset
                    </button>


                    <button
                        type="button"
                        class="button"
                        id="newRoleButton"
                    >
                        + New Role
                    </button>

                </div>

            </section>


            <!-- =========================
                 ROLE CARDS
            ========================== -->

            <section
                class="role-grid"
                id="roleGrid"
            >
            </section>


            <!-- =========================
                 ADMIN ASSIGNMENTS
            ========================== -->

            <section class="assignments">

                <div class="section-header">

                    <h2>
                        Administrator Assignments
                    </h2>

                    <p>
                        Review which roles are assigned to administrative users.
                    </p>

                </div>


                <div class="table-wrap">

                    <table>

                        <thead>

                            <tr>
                                <th>Administrator</th>
                                <th>Role</th>
                                <th>Access Level</th>
                                <th>Last Updated</th>
                                <th>Action</th>
                            </tr>

                        </thead>


                        <tbody id="assignmentTable">
                        </tbody>

                    </table>

                </div>

            </section>

        </section>

    </main>

</div>


<!-- =========================
     NEW ROLE MODAL
========================== -->

<div
    class="modal"
    id="roleModal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modalTitle"
>

    <div class="modal-card">

        <div class="modal-header">

            <h2 id="modalTitle">
                Create Administrator Role
            </h2>

            <button
                type="button"
                class="close"
                id="closeModal"
                aria-label="Close"
            >
                ×
            </button>

        </div>


        <form id="roleForm">

            <div class="form-grid">

                <div class="form-field">

                    <label for="roleName">
                        Role Name
                    </label>

                    <input
                        type="text"
                        id="roleName"
                        name="roleName"
                        placeholder="Example: Operations Manager"
                        required
                    >

                </div>


                <div class="form-field">

                    <label for="roleDescription">
                        Description
                    </label>

                    <textarea
                        id="roleDescription"
                        name="roleDescription"
                        placeholder="Describe the responsibilities and access level for this role."
                        required
                    ></textarea>

                </div>

            </div>


            <div class="modal-actions">

                <button
                    type="button"
                    class="button secondary"
                    id="cancelButton"
                >
                    Cancel
                </button>

                <button
                    type="submit"
                    class="button"
                >
                    Create Role
                </button>

            </div>

        </form>

    </div>

</div>


<script>

    /*
     * =========================================================
     * GTF ADMIN ROLE MANAGEMENT
     * =========================================================
     *
     * Backend integration points:
     *
     * GET    /api/roles
     * POST   /api/roles
     * PATCH  /api/roles/:id
     * DELETE /api/roles/:id
     *
     * Administrator assignment:
     *
     * GET    /api/roles/assignments
     * PATCH  /api/roles/assignments/:id
     *
     * This frontend currently uses safe demo records when
     * the backend endpoint is unavailable.
     */


    const API_BASE = "/api";


    const demoRoles = [

        {
            id: "role-super-admin",
            name: "Super Administrator",
            description:
                "Full administrative access across the banking administration platform.",
            type: "system",
            permissions: [
                "customers.view",
                "customers.manage",
                "accounts.view",
                "accounts.manage",
                "transactions.view",
                "transactions.manage",
                "compliance.view",
                "compliance.manage",
                "reports.view",
                "audit.view",
                "roles.manage",
                "settings.manage"
            ]
        },


        {
            id: "role-admin",
            name: "Administrator",
            description:
                "General administrative access for customer, account and operational management.",
            type: "system",
            permissions: [
                "customers.view",
                "customers.manage",
                "accounts.view",
                "accounts.manage",
                "transactions.view",
                "transactions.manage",
                "reports.view",
                "audit.view"
            ]
        },


        {
            id: "role-compliance",
            name: "Compliance Officer",
            description:
                "Access focused on compliance reviews, customer verification and audit activities.",
            type: "system",
            permissions: [
                "customers.view",
                "compliance.view",
                "compliance.manage",
                "audit.view",
                "reports.view"
            ]
        },


        {
            id: "role-operations",
            name: "Operations Manager",
            description:
                "Operational access for account and transaction administration.",
            type: "custom",
            permissions: [
                "customers.view",
                "accounts.view",
                "accounts.manage",
                "transactions.view",
                "transactions.manage",
                "reports.view"
            ]
        },


        {
            id: "role-support",
            name: "Customer Support",
            description:
                "Limited access for customer support and account inquiries.",
            type: "custom",
            permissions: [
                "customers.view",
                "accounts.view"
            ]
        },


        {
            id: "role-reporting",
            name: "Reporting Analyst",
            description:
                "Read-only access to operational reports and analytics.",
            type: "custom",
            permissions: [
                "reports.view",
                "transactions.view",
                "customers.view",
                "accounts.view"
            ]
        }

    ];


    const assignments = [

        {
            id: "ADM-001",
            name: "System Administrator",
            email: "administrator@example.com",
            role: "Super Administrator",
            level: "Full Access",
            updated: "2026-08-27"
        },

        {
            id: "ADM-002",
            name: "Operations Administrator",
            email: "operations@example.com",
            role: "Operations Manager",
            level: "Operational",
            updated: "2026-08-26"
        },

        {
            id: "ADM-003",
            name: "Compliance Officer",
            email: "compliance@example.com",
            role: "Compliance Officer",
            level: "Compliance",
            updated: "2026-08-25"
        },

        {
            id: "ADM-004",
            name: "Support Administrator",
            email: "support@example.com",
            role: "Customer Support",
            level: "Limited",
            updated: "2026-08-24"
        }

    ];


    let roles = [];
    let filteredRoles = [];


    const roleGrid =
        document.getElementById("roleGrid");

    const roleSearch =
        document.getElementById("roleSearch");

    const roleFilter =
        document.getElementById("roleFilter");

    const roleModal =
        document.getElementById("roleModal");


    function escapeHtml(value) {

        return String(value ?? "")
            .replace(/&/g, "&amp;")
            .replace(/</g, "&lt;")
            .replace(/>/g, "&gt;")
            .replace(/"/g, "&quot;")
            .replace(/'/g, "&#039;");

    }


    function renderRoles() {

        roleGrid.innerHTML = "";


        if (!filteredRoles.length) {

            roleGrid.innerHTML = `
                <div
                    style="
                        grid-column:1/-1;
                        padding:35px;
                        background:#fff;
                        border:1px solid #dce4eb;
                        border-radius:11px;
                        text-align:center;
                        color:#71808d;
                        font-size:8px;
                    "
                >
                    No roles found.
                </div>
            `;

            updateSummary();

            return;
        }


        filteredRoles.forEach(role => {

            const card =
                document.createElement("article");

            card.className = "role-card";


            const permissions =
                role.permissions || [];


            card.innerHTML = `

                <div class="role-header">

                    <div class="role-header-row">

                        <div>

                            <h2 class="role-name">
                                ${escapeHtml(role.name)}
                            </h2>

                            <p class="role-description">
                                ${escapeHtml(role.description)}
                            </p>

                        </div>

                        <span
                            class="role-badge ${
                                role.type === "system"
                                    ? "system"
                                    : ""
                            }"
                        >
                            ${escapeHtml(role.type)}
                        </span>

                    </div>

                </div>


                <div class="role-body">

                    <div class="permission-title">
                        Permissions
                    </div>

                    <div class="permissions">

                        ${
                            permissions
                                .map(
                                    permission => `
                                        <label class="permission">

                                            <input
                                                type="checkbox"
                                                checked
                                                data-role="${escapeHtml(role.id)}"
                                                data-permission="${escapeHtml(permission)}"
                                            >

                                            <span>
                                                ${escapeHtml(
                                                    formatPermission(
                                                        permission
                                                    )
                                                )}
                                            </span>

                                        </label>
                                    `
                                )
                                .join("")
                        }

                    </div>

                </div>


                <div class="role-footer">

                    <button
                        type="button"
                        class="small-button"
                        data-action="view"
                        data-id="${escapeHtml(role.id)}"
                    >
                        View
                    </button>

                    ${
                        role.type !== "system"
                            ? `
                                <button
                                    type="button"
                                    class="small-button primary"
                                    data-action="edit"
                                    data-id="${escapeHtml(role.id)}"
                                >
                                    Edit
                                </button>

                                <button
                                    type="button"
                                    class="small-button danger"
                                    data-action="delete"
                                    data-id="${escapeHtml(role.id)}"
                                >
                                    Delete
                                </button>
                            `
                            : `
                                <button
                                    type="button"
                                    class="small-button"
                                    disabled
                                >
                                    Protected
                                </button>
                            `
                    }

                </div>
            `;


            roleGrid.appendChild(card);

        });


        updateSummary();

    }


    function formatPermission(permission) {

        return String(permission)
            .replace(/\./g, " — ")
            .replace(/\b\w/g, char => char.toUpperCase());

    }


    function updateSummary() {

        document.getElementById(
            "totalRoles"
        ).textContent = roles.length;


        document.getElementById(
            "totalAdmins"
        ).textContent = assignments.length;


        const permissions =
            new Set();

        roles.forEach(role => {

            (role.permissions || [])
                .forEach(permission => {
                    permissions.add(permission);
                });

        });


        document.getElementById(
            "totalPermissions"
        ).textContent = permissions.size;


        document.getElementById(
            "systemRoles"
        ).textContent =
            roles.filter(
                role => role.type === "system"
            ).length;

    }


    function applyFilters() {

        const query =
            roleSearch.value
                .trim()
                .toLowerCase();


        const type =
            roleFilter.value;


        filteredRoles =
            roles.filter(role => {

                const matchesSearch =
                    !query ||
                    role.name
                        .toLowerCase()
                        .includes(query) ||
                    role.description
                        .toLowerCase()
                        .includes(query);


                const matchesType =
                    !type ||
                    role.type === type;


                return (
                    matchesSearch &&
                    matchesType
                );

            });


        renderRoles();

    }


    function renderAssignments() {

        const table =
            document.getElementById(
                "assignmentTable"
            );


        table.innerHTML = "";


        if (!assignments.length) {

            table.innerHTML = `
                <tr>
                    <td
                        colspan="5"
                        style="
                            text-align:center;
                            padding:30px;
                            color:#71808d;
                        "
                    >
                        No administrator assignments found.
                    </td>
                </tr>
            `;

            return;

        }


        assignments.forEach(assignment => {

            const row =
                document.createElement("tr");


            const initials =
                assignment.name
                    .split(" ")
                    .slice(0, 2)
                    .map(word => word[0])
                    .join("")
                    .toUpperCase();


            row.innerHTML = `

                <td>

                    <div class="employee">

                        <div class="avatar">
                            ${escapeHtml(initials)}
                        </div>

                        <div class="employee-info">

                            <strong>
                                ${escapeHtml(
                                    assignment.name
                                )}
                            </strong>

                            <span>
                                ${escapeHtml(
                                    assignment.email
                                )}
                            </span>

                        </div>

                    </div>

                </td>


                <td>

                    <span
                        class="assigned-role ${
                            assignment.role ===
                            "Super Administrator"
                                ? "super"
                                : ""
                        }"
                    >
                        ${escapeHtml(
                            assignment.role
                        )}
                    </span>

                </td>


                <td>
                    ${escapeHtml(
                        assignment.level
                    )}
                </td>


                <td>
                    ${escapeHtml(
                        assignment.updated
                    )}
                </td>


                <td>

                    <button
                        type="button"
                        class="table-action"
                        data-assignment-id="${escapeHtml(
                            assignment.id
                        )}"
                    >
                        Change Role
                    </button>

                </td>

            `;


            table.appendChild(row);

        });

    }


    async function loadRoles() {

        try {

            const response =
                await fetch(
                    `${API_BASE}/roles`,
                    {
                        method: "GET",
                        headers: {
                            "Accept":
                                "application/json"
                        },
                        credentials: "include"
                    }
                );


            if (!response.ok) {
                throw new Error(
                    `API returned ${response.status}`
                );
            }


            const data =
                await response.json();


            const records =
                Array.isArray(data)
                    ? data
                    : Array.isArray(data.roles)
                        ? data.roles
                        : Array.isArray(data.data)
                            ? data.data
                            : [];


            roles =
                records.length
                    ? records
                    : demoRoles;


        } catch (error) {

            console.warn(
                "Roles API unavailable. Using demo data.",
                error
            );

            roles = demoRoles;

        }


        applyFilters();

    }


    function openModal() {

        roleModal.classList.add("open");

        document
            .getElementById("roleName")
            .focus();

    }


    function closeModal() {

        roleModal.classList.remove("open");

    }


    roleSearch.addEventListener(
        "input",
        applyFilters
    );


    roleFilter.addEventListener(
        "change",
        applyFilters
    );


    document
        .getElementById("resetButton")
        .addEventListener(
            "click",
            function() {

                roleSearch.value = "";
                roleFilter.value = "";

                applyFilters();

            }
        );


    document
        .getElementById("newRoleButton")
        .addEventListener(
            "click",
            openModal
        );


    document
        .getElementById("closeModal")
        .addEventListener(
            "click",
            closeModal
        );


    document
        .getElementById("cancelButton")
        .addEventListener(
            "click",
            closeModal
        );


    roleModal.addEventListener(
        "click",
        function(event) {

            if (
                event.target ===
                roleModal
            ) {
                closeModal();
            }

        }
    );


    document.addEventListener(
        "keydown",
        function(event) {

            if (
                event.key === "Escape"
            ) {
                closeModal();
            }

        }
    );


    document
        .getElementById("roleForm")
        .addEventListener(
            "submit",
            async function(event) {

                event.preventDefault();


                const name =
                    document
                        .getElementById(
                            "roleName"
                        )
                        .value
                        .trim();


                const description =
                    document
                        .getElementById(
                            "roleDescription"
                        )
                        .value
                        .trim();


                if (
                    !name ||
                    !description
                ) {
                    return;
                }


                const newRole = {

                    id:
                        `role-${Date.now()}`,

                    name,

                    description,

                    type: "custom",

                    permissions: [
                        "customers.view"
                    ]

                };


                /*
                 * Backend integration point:
                 *
                 * POST /api/roles
                 *
                 * body:
                 * {
                 *   name,
                 *   description,
                 *   type,
                 *   permissions
                 * }
                 */


                roles.push(newRole);


                document
                    .getElementById(
                        "roleForm"
                    )
                    .reset();


                closeModal();

                applyFilters();


                alert(
                    `Role "${name}" created successfully in the frontend.`
                );

            }
        );


    roleGrid.addEventListener(
        "click",
        function(event) {

            const button =
                event.target.closest(
                    "[data-action]"
                );


            if (!button) {
                return;
            }


            const action =
                button.dataset.action;

            const id =
                button.dataset.id;


            const role =
                roles.find(
                    item => item.id === id
                );


            if (!role) {
                return;
            }


            if (action === "view") {

                alert(
                    `${role.name}\n\n${role.description}\n\nPermissions: ${role.permissions.length}`
                );

                return;
            }


            if (action === "edit") {

                alert(
                    `Editing "${role.name}" will be connected to PATCH /api/roles/${role.id}.`
                );

                return;
            }


            if (action === "delete") {

                const confirmed =
                    window.confirm(
                        `Delete the custom role "${role.name}"?`
                    );


                if (!confirmed) {
                    return;
                }


                roles =
                    roles.filter(
                        item =>
                            item.id !== id
                    );


                applyFilters();

            }

        }
    );


    roleGrid.addEventListener(
        "change",
        function(event) {

            if (
                event.target.type !==
                "checkbox"
            ) {
                return;
            }


            const roleId =
                event.target.dataset.role;

            const permission =
                event.target.dataset.permission;


            /*
             * Backend integration point:
             *
             * PATCH /api/roles/:id
             *
             * This is where the changed permission
             * should be persisted after backend
             * authorization is implemented.
             */


            console.log(
                "Permission changed:",
                {
                    roleId,
                    permission,
                    enabled:
                        event.target.checked
                }
            );

        }
    );


    document
        .getElementById("assignmentTable")
        .addEventListener(
            "click",
            function(event) {

                const button =
                    event.target.closest(
                        "[data-assignment-id]"
                    );


                if (!button) {
                    return;
                }


                const assignment =
                    assignments.find(
                        item =>
                            item.id ===
                            button.dataset
                                .assignmentId
                    );


                if (!assignment) {
                    return;
                }


                alert(
                    `Role assignment management for ${assignment.name} will connect to the backend roles assignment endpoint.`
                );

            }
        );


    document
        .getElementById("logoutButton")
        .addEventListener(
            "click",
            function() {

                /*
                 * Replace this with the real
                 * Supabase authentication sign-out
                 * when the authentication layer
                 * is connected.
                 */

                window.location.href =
                    "./login.html";

            }
        );


    renderAssignments();

    loadRoles();

</script>

</body>
