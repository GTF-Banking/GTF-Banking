async function createRole(
    name,
    description
) {

    const newRole = {

        id:
            `role-${Date.now()}`,

        name,

        description,

        type: "custom",

        permissions: [
            "customers.view"
        ]

    };


    /*
     * Production implementation:
     *
     * const response = await fetchJson(
     *     `${API_BASE}/roles`,
     *     {
