    filteredRoles =
        roles.filter(role => {

            const searchableText = [

                role.name,

                role.description,

                role.type,

                ...(role.permissions || [])

            ]
                .join(" ")
                .toLowerCase();


            const matchesSearch =
                !query ||
                searchableText.includes(
                    query
                );


            const matchesType =
                !type ||
                role.type === type;


            return (
                matchesSearch &&
                matchesType
            );

        });


    renderRoles();

}


