<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <meta
        name="description"
        content="Global TrustFund Banking administrator sign out."
    >

    <meta
        name="theme-color"
        content="#0b3d2e"
    >

    <title>
        Sign Out | Global TrustFund Admin
    </title>

    <link
        rel="stylesheet"
        href="../css/styles.css"
    >

    <style>

        /* =========================================================
           GLOBAL TRUSTFUND ADMIN SIGN OUT
           ========================================================= */

        :root {

            --gtf-green: #0b3d2e;
            --gtf-green-dark: #092f24;
            --gtf-green-light: #176b48;

            --gtf-gold: #c9962b;

            --gtf-bg: #f4f8f6;
            --gtf-card: #ffffff;
            --gtf-border: #dfe8e3;

            --gtf-text: #18372c;
            --gtf-muted: #7c8983;

            --success-bg: #eaf5ee;
            --success-text: #176b48;

            --info-bg: #edf5fa;
            --info-text: #24627f;

            --danger-bg: #f9eded;
            --danger-text: #8b4444;

        }


        * {
            box-sizing: border-box;
        }


        html,
        body {

            margin: 0;
            padding: 0;

            min-height: 100%;

        }


        body {

            min-height: 100vh;

            background:
                var(--gtf-bg);

            color:
                var(--gtf-text);

            font-family:
                Arial,
                Helvetica,
                sans-serif;

        }


        button,
        input {

            font: inherit;

        }


        button {

            cursor: pointer;

        }


        /* =========================================================
           PAGE
           ========================================================= */

        .admin-page {

            min-height: 100vh;

            display: flex;

            flex-direction: column;

        }


        /* =========================================================
           HEADER
           ========================================================= */

        .admin-header {

            position: sticky;

            top: 0;

            z-index: 100;

            background:
                #ffffff;

            border-bottom:
                1px solid
                var(--gtf-border);

            box-shadow:
                0 4px 18px
                rgba(
                    11,
                    61,
                    46,
                    .05
                );

        }


        .admin-header-inner {

            width: 100%;

            max-width: 1440px;

            min-height: 72px;

            margin: 0 auto;

            padding:
                12px 25px;

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 20px;

        }


        /* =========================================================
           BRAND
           ========================================================= */

        .brand {

            display: inline-flex;

            align-items: center;

            gap: 10px;

            color:
                var(--gtf-green);

            text-decoration: none;

        }


        .brand-logo {

            width: 45px;

            height: 45px;

            display: block;

            object-fit: contain;

        }


        .brand-text {

            display: flex;

            flex-direction: column;

        }


        .brand-text strong {

            color:
                var(--gtf-green);

            font-size: 14px;

            line-height: 1.2;

            font-weight: 800;

        }


        .brand-text small {

            margin-top: 3px;

            color:
                var(--gtf-muted);

            font-size: 9px;

        }


        /* =========================================================
           HEADER ADMIN
           ========================================================= */

        .admin-header-right {

            display: flex;

            align-items: center;

            gap: 13px;

        }


        .admin-label {

            display: flex;

            flex-direction: column;

            text-align: right;

        }


        .admin-label strong {

            color:
                var(--gtf-text);

            font-size: 9px;

        }


        .admin-label span {

            margin-top: 3px;

            color:
                var(--gtf-muted);

            font-size: 7px;

        }


        .admin-avatar {

            width: 36px;

            height: 36px;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 50%;

            background:
                var(--gtf-green);

            color:
                #ffffff;

            font-size: 9px;

            font-weight: 800;

        }


        .logout-button {

            min-height: 32px;

            padding:
                0 11px;

            border:
                1px solid
                var(--gtf-border);

            border-radius: 6px;

            background:
                #ffffff;

            color:
                var(--gtf-green);

            font-size: 7px;

            font-weight: 700;

        }


        .logout-button:hover {

            background:
                var(--gtf-bg);

        }


        /* =========================================================
           MAIN AREA
           ========================================================= */

        .signout-main {

            width: 100%;

            max-width: 1440px;

            margin: 0 auto;

            padding:
                55px 25px;

            display: flex;

            align-items: center;

            justify-content: center;

            flex: 1;

        }


        .signout-card {

            width: 100%;

            max-width: 520px;

            overflow: hidden;

            background:
                var(--gtf-card);

            border:
                1px solid
                var(--gtf-border);

            border-radius: 14px;

            box-shadow:
                0 15px 45px
                rgba(
                    11,
                    61,
                    46,
                    .08
                );

        }


        /* =========================================================
           CARD TOP
           ========================================================= */

        .card-accent {

            height: 6px;

            background:
                linear-gradient(
                    90deg,
                    var(--gtf-green),
                    var(--gtf-green-light),
                    var(--gtf-gold)
                );

        }


        /* =========================================================
           CONTENT
           ========================================================= */

        .signout-content {

            padding:
                38px 35px 30px;

            text-align: center;

        }


        .logo {

            width: 76px;

            height: 76px;

            margin:
                0 auto 20px;

            display: block;

            object-fit: contain;

        }


        .eyebrow {

            margin-bottom: 7px;

            color:
                var(--gtf-muted);

            font-size: 7px;

            font-weight: 800;

            letter-spacing: 1px;

            text-transform: uppercase;

        }


        h1 {

            margin: 0;

            color:
                var(--gtf-green);

            font-size: 24px;

            line-height: 1.2;

            font-weight: 800;

        }


        .message {

            max-width: 370px;

            margin:
                10px auto 0;

            color:
                var(--gtf-muted);

            font-size: 8px;

            line-height: 1.7;

        }


        /* =========================================================
           STATUS
           ========================================================= */

        .status {

            margin:
                24px auto;

            padding:
                12px 15px;

            display: flex;

            align-items: center;

            justify-content: center;

            gap: 8px;

            border:
                1px solid
                #d8eadf;

            border-radius: 8px;

            background:
                var(--success-bg);

            color:
                var(--success-text);

            font-size: 8px;

            font-weight: 700;

        }


        .status-dot {

            width: 7px;

            height: 7px;

            flex:
                0 0 7px;

            border-radius: 50%;

            background:
                var(--success-text);

            animation:
                pulse 1.4s infinite;

        }


        @keyframes pulse {

            0% {
                opacity: 1;
                transform: scale(1);
            }

            50% {
                opacity: .45;
                transform: scale(.75);
            }

            100% {
                opacity: 1;
                transform: scale(1);
            }

        }


        /* =========================================================
           ACTIONS
           ========================================================= */

        .actions {

            display: grid;

            gap: 9px;

        }


        .button {

            width: 100%;

            min-height: 40px;

            padding:
                0 14px;

            border:
                1px solid
                var(--gtf-border);

            border-radius: 6px;

            background:
                #ffffff;

            color:
                var(--gtf-green);

            font-size: 8px;

            font-weight: 700;

            transition:
                background .2s ease,
                border-color .2s ease,
                transform .2s ease;

        }


        .button:hover {

            background:
                var(--gtf-bg);

            transform:
                translateY(-1px);

        }


        .button-primary {

            border-color:
                var(--gtf-green);

            background:
                var(--gtf-green);

            color:
                #ffffff;

        }


        .button-primary:hover {

            border-color:
                var(--gtf-green-dark);

            background:
                var(--gtf-green-dark);

        }


        .button-secondary {

            background:
                #f8faf9;

            color:
                var(--gtf-green);

        }


        .button-secondary:hover {

            background:
                var(--gtf-bg);

        }


        /* =========================================================
           SECURITY NOTE
           ========================================================= */

        .security-note {

            margin-top: 22px;

            padding-top: 17px;

            border-top:
                1px solid
                var(--gtf-border);

            color:
                var(--gtf-muted);

            font-size: 7px;

            line-height: 1.7;

        }


        .security-note strong {

            color:
                var(--gtf-text);

        }


        /* =========================================================
           FOOTER
           ========================================================= */

        .admin-footer {

            padding:
                16px 25px;

            background:
                #ffffff;

            border-top:
                1px solid
                var(--gtf-border);

        }


        .admin-footer-inner {

            width: 100%;

            max-width: 1440px;

            margin: 0 auto;

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 15px;

            color:
                var(--gtf-muted);

            font-size: 7px;

        }


        /* =========================================================
           LOADING
           ========================================================= */

        .loading {

            pointer-events: none;

            opacity: .65;

        }


        .hidden {

            display: none !important;

        }


        /* =========================================================
           RESPONSIVE
           ========================================================= */

        @media (max-width: 700px) {

            .admin-header-inner {

                padding:
                    10px 15px;

            }


            .admin-label {

                display: none;

            }


            .signout-main {

                padding:
                    35px 15px;

            }


            .signout-content {

                padding:
                    32px 23px 27px;

            }


            h1 {

                font-size: 21px;

            }

        }


        @media (max-width: 450px) {

            .brand-text {

                display: none;

            }


            .admin-header-right {

                gap: 8px;

            }


            .admin-avatar {

                width: 34px;

                height: 34px;

            }


            .signout-main {

                padding:
                    25px 12px;

            }


            .signout-content {

                padding:
                    30px 20px 25px;

            }


            .logo {

                width: 68px;

                height: 68px;

            }


            .admin-footer-inner {

                flex-direction: column;

                text-align: center;

            }

        }

    </style>

</head>


<body>


<div class="admin-page">


    <!-- =====================================================
         HEADER
         ===================================================== -->

    <header class="admin-header">

        <div class="admin-header-inner">


            <a
                href="./index.html"
                class="brand"
                aria-label="Global TrustFund Administration"
            >

                <img
                    src="../assets/gtf-logo.svg"
                    class="brand-logo"
                    alt="Global TrustFund logo"
                >


                <span class="brand-text">

                    <strong>
                        Global TrustFund
                    </strong>

                    <small>
                        Administration
                    </small>

                </span>

            </a>


            <div class="admin-header-right">


                <div class="admin-label">

                    <strong>
                        Administrator
                    </strong>

                    <span>
                        Secure Session
                    </span>

                </div>


                <div
                    class="admin-avatar"
                    aria-hidden="true"
                >
                    AD
                </div>


                <button
                    type="button"
                    class="logout-button"
                    id="headerLoginButton"
                >
                    Login
                </button>

            </div>

        </div>

    </header>


    <!-- =====================================================
         MAIN
         ===================================================== -->

    <main class="signout-main">


        <section
            class="signout-card"
            aria-labelledby="signoutTitle"
        >


            <div class="card-accent"></div>


            <div class="signout-content">


                <img
                    class="logo"
                    src="../assets/gtf-logo.svg"
                    alt="Global TrustFund Banking"
                >


                <div class="eyebrow">
                    Administrator Security
                </div>


                <h1 id="signoutTitle">
                    Signing Out
                </h1>


                <p class="message">
                    Your Global TrustFund administrator session
                    is being securely terminated. Please wait
                    while the sign-out process is completed.
                </p>


                <!-- =================================================
                     STATUS
                     ================================================= -->

                <div
                    class="status"
                    id="statusMessage"
                    role="status"
                    aria-live="polite"
                >

                    <span
                        class="status-dot"
                        id="statusDot"
                    ></span>


                    <span id="statusText">
                        Signing out securely...
                    </span>

                </div>


                <!-- =================================================
                     ACTIONS
                     ================================================= -->

                <div class="actions">


                    <button
                        type="button"
                        class="button button-primary hidden"
                        id="loginButton"
                    >
                        Return to Administrator Login
                    </button>


                    <button
                        type="button"
                        class="button button-secondary hidden"
                        id="dashboardButton"
                    >
                        Return to Dashboard
                    </button>


                </div>


                <!-- =================================================
                     SECURITY NOTE
                     ================================================= -->

                <div class="security-note">

                    <strong>
                        Security reminder:
                    </strong>

                    Always sign out when using the administrator
                    portal on a shared or public device.

                </div>


            </div>


            <!-- =================================================
                 CARD FOOTER
                 ================================================= -->

            <footer class="admin-footer">

                <div class="admin-footer-inner">

                    <span>
                        © 2026 Global TrustFund.
                    </span>

                    <span>
                        Administrator Portal
                    </span>

                </div>

            </footer>


        </section>


    </main>


</div>


<script>

    /* =========================================================
       GTF ADMINISTRATOR SIGN OUT
       ========================================================= */


    const API_BASE =
        "/api";


    const statusText =
        document.getElementById(
            "statusText"
        );


    const statusMessage =
        document.getElementById(
            "statusMessage"
        );


    const statusDot =
        document.getElementById(
            "statusDot"
        );


    const loginButton =
        document.getElementById(
            "loginButton"
        );


    const dashboardButton =
        document.getElementById(
            "dashboardButton"
        );


    const headerLoginButton =
        document.getElementById(
            "headerLoginButton"
        );


    /* =========================================================
       LOCAL SESSION CLEANUP
       ========================================================= */

    function clearLocalSession() {

        const keysToRemove = [

            "gtf_user",

            "gtf_admin",

            "gtf_admin_user",

            "gtf_session",

            "gtf_access_token",

            "gtf_refresh_token",

            "access_token",

            "refresh_token",

            "supabase.auth.token"

        ];


        keysToRemove.forEach(
            function(key) {

                try {

                    localStorage.removeItem(
                        key
                    );

                } catch (error) {

                    console.warn(
                        "Unable to remove localStorage key:",
                        key
                    );

                }

            }
        );


        try {

            sessionStorage.clear();

        } catch (error) {

            console.warn(
                "Unable to clear sessionStorage.",
                error
            );

        }

    }


    /* =========================================================
       STATUS HELPERS
       ========================================================= */

    function setStatus(
        message,
        type = "success"
    ) {

        statusText.textContent =
            message;


        statusMessage.classList.remove(
            "success",
            "error"
        );


        if (type === "error") {

            statusMessage.style.background =
                "var(--danger-bg)";

            statusMessage.style.borderColor =
                "#edd6d6";

            statusMessage.style.color =
                "var(--danger-text)";

            statusDot.style.background =
                "var(--danger-text)";

        } else {

            statusMessage.style.background =
                "var(--success-bg)";

            statusMessage.style.borderColor =
                "#d8eadf";

            statusMessage.style.color =
                "var(--success-text)";

            statusDot.style.background =
                "var(--success-text)";

        }

    }


    /* =========================================================
       SHOW LOGIN ACTION
       ========================================================= */

    function showLoginButton() {

        loginButton.classList.remove(
            "hidden"
        );


        dashboardButton.classList.add(
            "hidden"
        );

    }


    /* =========================================================
       SHOW DASHBOARD ACTION
       ========================================================= */

    function showDashboardButton() {

        dashboardButton.classList.remove(
            "hidden"
        );


        loginButton.classList.add(
            "hidden"
        );

    }


    /* =========================================================
       SIGN OUT
       ========================================================= */

    async function signOut() {

        loginButton.classList.add(
            "hidden"
        );


        dashboardButton.classList.add(
            "hidden"
        );


        headerLoginButton.disabled =
            true;


        headerLoginButton.classList.add(
            "loading"
        );


        setStatus(
            "Signing out securely..."
        );


        try {

            const response =
                await fetch(
                    `${API_BASE}/auth/signout`,
                    {
                        method: "POST",

                        headers: {

                            "Accept":
                                "application/json",

                            "Content-Type":
                                "application/json"

                        },

                        credentials:
                            "include",

                        body:
                            JSON.stringify({
                                role:
                                    "administrator"
                            })

                    }
                );


            /*
             * Local authentication information must be
             * cleared regardless of the API response.
             */

            clearLocalSession();


            if (response.ok) {

                setStatus(
                    "You have been signed out successfully."
                );

            } else {

                setStatus(
                    "Your administrator session has been cleared."
                );

            }


        } catch (error) {

            console.warn(
                "Sign-out API unavailable:",
                error
            );


            /*
             * The backend may not be running during local
             * frontend development. Local credentials are
             * still removed.
             */

            clearLocalSession();


            setStatus(
                "Your local administrator session has been cleared."
            );

        }


        showLoginButton();


        headerLoginButton.disabled =
            false;


        headerLoginButton.classList.remove(
            "loading"
        );


        /*
         * Automatically return to the administrator
         * login page after a short confirmation.
         */

        setTimeout(
            function() {

                window.location.replace(
                    "./login.html"
                );

            },
            1500
        );

    }


    /* =========================================================
       LOGIN BUTTON
       ========================================================= */

    loginButton.addEventListener(
        "click",
        function() {

            window.location.replace(
                "./login.html"
            );

        }
    );


    /* =========================================================
       HEADER LOGIN BUTTON
       ========================================================= */

    headerLoginButton.addEventListener(
        "click",
        function() {

            window.location.replace(
                "./login.html"
            );

        }
    );


    /* =========================================================
       DASHBOARD BUTTON
       ========================================================= */

    dashboardButton.addEventListener(
        "click",
        function() {

            window.location.replace(
                "./index.html"
            );

        }
    );


    /* =========================================================
       BROWSER HISTORY PROTECTION
       ========================================================= */

    window.history.replaceState(
        null,
        "",
        window.location.href
    );


    window.addEventListener(
        "popstate",
        function() {

            window.location.replace(
                "./login.html"
            );

        }
    );


    /* =========================================================
       START SIGN OUT
       ========================================================= */

    document.addEventListener(
        "DOMContentLoaded",
        function() {

            signOut();

        }
    );

</script>


</body>

</html>
