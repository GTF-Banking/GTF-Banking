            label: "Contact"
        },

        support: {
            path: "/support.html",
            label: "Support"
        },

        security: {
            path: "/security.html",
            label: "Security"
        },


        /* =====================================================
           CUSTOMER
           ===================================================== */

        customerLogin: {
            path: "/customer/login.html",
            label: "Customer Sign In"
        },

        customerRegister: {
            path: "/customer/register.html",
            label: "Open an Account"
        },

        customerDashboard: {
            path: "/customer/dashboard.html",
            label: "Dashboard"
        },

        customerAccounts: {
            path: "/customer/accounts.html",
            label: "Accounts"
        },

        customerTransfers: {
            path: "/customer/transfers.html",
            label: "Transfers"
        },

        customerPayments: {
