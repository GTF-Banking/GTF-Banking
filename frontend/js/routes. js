            label: "Notifications"
        },


        /* =====================================================
           MANAGEMENT
           ===================================================== */

        managerLogin: {
            path: "/manager/login.html",
            label: "Management Sign In"
        },

        managerDashboard: {
            path: "/manager/index.html",
            label: "Management Portal"
        },


        /* =====================================================
           CASHIER
           ===================================================== */

        cashierLogin: {
            path: "/cashier/login.html",
            label: "Cashier Sign In"
        },

        cashierDashboard: {
            path: "/cashier/index.html",
            label: "Cashier Portal"
        }

    };


    /* =========================================================
       PUBLIC API
       ========================================================= */

    window.GTF_ROUTES = ROUTES;


    /* =========================================================
       GET ROUTE
       ========================================================= */

    window.gtfRoute = function (name) {

        if (!ROUTES[name]) {

            console.warn(
                "[GTF Routes] Unknown route:",
                name
            );

            return "#";

        }

        return ROUTES[name].path;

    };


    /* =========================================================
       NAVIGATION
       ========================================================= */

    window.gtfNavigate = function (name) {

        const route =
            gtfRoute(name);

        if (route && route !== "#") {

            window.location.href =
                route;

        }

    };


})(window);
